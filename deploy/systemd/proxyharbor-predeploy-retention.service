[Unit]
Description=ProxyHarbor bounded predeploy backup retention
Documentation=file:///opt/proxyharbor/docs/DEPLOYMENT.md
ConditionPathIsDirectory=/opt/proxyharbor
ConditionFileIsExecutable=/opt/proxyharbor/tools/Prune-PredeployBackups.sh
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/proxyharbor
ExecStart=/opt/proxyharbor/tools/Prune-PredeployBackups.sh --directory /opt/proxyharbor --keep-count 7 --apply
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/opt/proxyharbor
