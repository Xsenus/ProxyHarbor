# Обязательно замените значения перед первым запуском.
POSTGRES_DB=proxyharbor
POSTGRES_USER=proxyharbor
POSTGRES_PASSWORD=replace-with-long-random-password
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-random-Admin-password-42!
ADMIN_API_KEY=replace-with-long-random-admin-key
# SMTP необязателен для запуска, но необходим для восстановления пароля.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD_FILE=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=ProxyHarbor
PUBLIC_BASE_URL=https://proxy.example.com
CHECKER_AGENT_IMAGE=ghcr.io/xsenus/proxyharbor-checker-agent:latest
BACKGROUND_WORKERS_ENABLED=true
VALIDATION_CONCURRENCY=800
VALIDATION_BATCH_SIZE=1600
VPN_VALIDATION_CONCURRENCY=800
VPN_VALIDATION_BATCH_SIZE=1600
VPN_REACHABLE_VALIDATION_INTERVAL_MINUTES=10
VPN_UNREACHABLE_RETRY_MINUTES=30
VPN_UNSUPPORTED_RETRY_MINUTES=360
VPN_PUBLIC_FRESHNESS_MINUTES=15
BACKUP_ENABLED=true
BACKUP_HISTORY_RETENTION_DAYS=365
BACKUP_ENCRYPTION_KEY=replace-with-32-or-more-random-characters
TELEGRAM_BOT_TOKEN=
# Token: 20..256 printable ASCII без /, \, ?, #, %; chat ID числовой, отрицательный для group/channel.
TELEGRAM_CHAT_ID=
# Рекламные Telegram-рассылки заблокированы на уровне deploy до отдельного
# юридического заключения о допустимости рекламы сервиса.
TELEGRAM_MARKETING_BROADCASTS_ENABLED=false
BACKEND_SUBNET=172.30.0.0/24

# Биллинг выключен до заключения договора хотя бы с одним провайдером.
PAYMENTS_ENABLED=false
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOMONEY_ENABLED=false
YOOMONEY_WALLET=
YOOMONEY_NOTIFICATION_SECRET=
CLOUDPAYMENTS_ENABLED=false
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
ROBOKASSA_ENABLED=false
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_MODE=false
TBANK_ENABLED=false
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
# Stripe применим только для merchant из поддерживаемой Stripe страны/региона.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRYPTOMUS_ENABLED=false
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_KEY=
NOWPAYMENTS_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Host-protection limits для core production containers; увеличивайте осознанно.
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0
API_MEMORY_LIMIT=2g
API_CPU_LIMIT=2.0
RESTORE_MEMORY_LIMIT=2g
RESTORE_CPU_LIMIT=2.0
WEB_MEMORY_LIMIT=256m
WEB_CPU_LIMIT=0.5
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=0.5

# Production HTTPS (hostname без https:// и контакт центра сертификации).
PUBLIC_HOST=proxy.example.com
ACME_EMAIL=admin@example.com

# Опциональный production profile monitoring.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB
ALERTMANAGER_PORT=9093
ALERTMANAGER_RETENTION_TIME=120h

# Только для запуска опубликованных GHCR-образов через docker-compose.release.yml.
# PROXYHARBOR_IMAGE_PREFIX=ghcr.io/your-github-owner
# PROXYHARBOR_IMAGE_TAG=1.0.0
