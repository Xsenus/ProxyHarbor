{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=proxyharbor;Username=proxyharbor;Password=proxyharbor_dev"
  },
  "Collector": {
    "BackgroundWorkersEnabled": true,
    "CollectionIntervalMinutes": 15,
    "ValidationIntervalMinutes": 5,
    "PublicFreshnessMinutes": 15,
    "DeadRetryBaseMinutes": 15,
    "DeadRetryMaxHours": 24,
    "ValidationConcurrency": 200,
    "ValidationBatchSize": 1000,
    "ProbeTimeoutSeconds": 8,
    "SourceTimeoutSeconds": 20,
    "SourceConcurrency": 8,
    "SourceRetryCount": 2,
    "SourceFailureBackoffBaseMinutes": 15,
    "SourceFailureBackoffMaxHours": 24,
    "MaxProxiesPerSource": 500000,
    "MaxCandidatesPerRun": 500000,
    "LastSeenRefreshMinutes": 360,
    "DeadRetentionDays": 3,
    "RunRetentionDays": 30,
    "ProbeHost": "api.ipify.org",
    "ProbePort": 443,
    "ProbePath": "/?format=json"
  },
  "Backup": {
    "Enabled": false,
    "IntervalHours": 24,
    "Directory": "backups",
    "RetentionDays": 7,
    "HistoryRetentionDays": 365,
    "MaxTelegramFileSizeMb": 49
  },
  "Security": { "AdminApiKey": "" },
  "Cors": { "Origins": [] },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
  "AllowedHosts": "*"
}
